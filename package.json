{
  "name": "dsh-ide-mode",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IDE mode for the DSH web client: a top-left mode switch that turns the shell into an Explorer/Search/Git + File/Terminal workspace around the live conversation.",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
